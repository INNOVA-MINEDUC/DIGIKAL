# =============================================================================
# Variables que consume docker-compose.yml (NO son las del backend).
#
# Copie este archivo a `.env` en esta misma carpeta y ponga valores reales.
# El .env está en .gitignore: nunca debe subirse al repositorio.
#
#   cp .env.example .env
#
# Las variables del servidor Node viven aparte, en backend/.env
# (ver backend/.env.example).
# =============================================================================

# Contraseña de root de MySQL. Antes estaba escrita como "root" dentro del
# propio docker-compose.yml, que sí va al repositorio.
# Genere una: openssl rand -base64 24
DB_ROOT_PASSWORD=

# Usuario de aplicación con permisos solo sobre la base de DIGIKAL.
# El backend NO debería conectarse como root.
DB_NAME=innova_spa
DB_USER=digikal
DB_PASSWORD=

# development | production
NODE_ENV=development

# ── Solo para el stack de producción (docker-compose.prod.yml) ───────────────
# URL pública del API, la que usará el navegador de los visitantes.
# Vite la INCRUSTA en el bundle al construir el frontend: no se lee al
# arrancar el contenedor, así que cambiarla exige reconstruir la imagen.
# Si falta, el bundle sale apuntando a http://localhost:3000, que en el
# navegador de un visitante es SU PROPIA máquina y ninguna llamada llega.
VITE_API_URL=https://api.midominio.gt

# Puertos publicados en el servidor (opcionales).
# El frontend de producción lo sirve nginx en el 8080, no Vite en el 5173.
FRONTEND_PORT=8080
BACKEND_PORT=3000
