# =============================================================================
# Configuración del backend de DIGIKAL.
#
# Copie este archivo a `.env` y complete los valores:  cp .env.example .env
# El .env está en .gitignore y nunca debe subirse al repositorio.
#
# config/env.js valida esto al arrancar: si falta algo obligatorio o el secreto
# es débil, el servidor NO levanta y dice exactamente qué falta.
# =============================================================================

# ── Base de datos (obligatorio) ──────────────────────────────────────────────
# Con Docker, DB_HOST es el nombre del servicio: db
DB_HOST=localhost
DB_NAME=innova_spa
DB_USER=digikal
DB_PASSWORD=
DB_DIALECT=mysql

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Nivel de registro: error | warn | info | debug
# Si se deja vacío: con NODE_ENV=production sólo se emiten errores; en cualquier
# otro entorno se emite todo. Los ERRORES nunca se silencian: son el único
# rastro cuando algo falla en un servidor que nadie está mirando.
# Para depurar un incidente en producción sin tocar código: LOG_LEVEL=debug
LOG_LEVEL=

# ── CORS (obligatorio) ───────────────────────────────────────────────────────
# Orígenes del frontend, separados por coma. Si falta, el servidor no arranca:
# antes, sin esta variable, CORS caía a "*" y aceptaba peticiones de cualquier
# sitio.
#
# IMPORTANTE — cada uno de estos es un origen DISTINTO para el navegador, y
# todos los que se usen deben estar en la lista:
#   http://localhost:5173   ≠   http://127.0.0.1:5173     (distinto host)
#   http://localhost:5173   ≠   http://localhost:5174     (distinto puerto)
#   http://ejemplo.gt       ≠   https://ejemplo.gt        (distinto esquema)
#
# Vite usa 5173 y salta al 5174 si está ocupado; `vite preview` usa el 4173.
# En producción, deje sólo el dominio real:
#   FRONTEND_URL=https://digikal.mineduc.gob.gt
#
# El servidor imprime al arrancar los orígenes que acepta, y avisa en el log
# cuando bloquea uno, con el valor exacto que habría que añadir aquí.
FRONTEND_URL=http://localhost:5173


# ── Sesiones (obligatorio) ───────────────────────────────────────────────────
# Mínimo 32 caracteres. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Ya no existe ningún valor por defecto en el código: si esto falta, el
# servidor se niega a arrancar en lugar de firmar tokens con "secret".
JWT_SECRET=

# Vigencia del token de acceso (2h, 8h, 1d...). Por defecto 8h.
# Se puede revocar antes con tokenVersion (cambio de contraseña, baja, logout).
JWT_EXPIRES_IN=8h

# ── Acceso público ───────────────────────────────────────────────────────────
# true  → el mapa y el tablero de la portada se ven sin iniciar sesión
#         (solo datos agregados; la ficha de escuela siempre pide sesión)
# false → hay que iniciar sesión para ver cualquier cosa
API_PUBLICA=true

# ── APIs del MINEDUC ─────────────────────────────────────────────────────────
MDM_GRAPHQL_URL=
MDM_PUBLIC_TOKEN=
AYUDA_GRAPHQL_URL=
AYUDA_PUBLIC_TOKEN=

# ── Almacenamiento de archivos (bucket COSMO) ────────────────────────────────
STORAGE_SERVICE_URL=
STORAGE_API_KEY=

# Exigir que las actas y las fotos acaben en el bucket.
#   true (por defecto) → si el bucket no responde, la dotación NO se registra y
#                        el usuario ve el motivo. Nada acaba en disco a escondidas.
#   false              → se permite el respaldo en backend/uploads/ (queda con el
#                        prefijo `local:` en la base y NADIE lo reintenta solo).
#
# Para subir al bucket lo que ya quedó en local:  npm run uploads:migrar
# (informa sin tocar nada; añada --aplicar para ejecutarlo)
STORAGE_REQUIRE_BUCKET=true
