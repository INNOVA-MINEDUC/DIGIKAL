# Copiar a backend/.env y rellenar. El .env está en .gitignore: los tokens
# nunca van en el código ni se commitean.

PORT=3000
FRONTEND_URL=http://localhost:5173

# ── API de ayuda/mantenimiento del MINEDUC ──────────────────────────────────
# Queries que consume el dashboard:
#   · estadisticasEstablecimientos(filtro: { departamento, municipio })
#       → totales del país + lista completa de establecimientos
#   · establecimiento(id) { inventario }
#       → detalle e inventario de un establecimiento
# El filtro es por NOMBRE, no por id. Si se filtra municipio hay que mandar
# también el departamento.
MDM_GRAPHQL_URL=https://api-ayuda.mineduc.edu.gt/graphql
MDM_PUBLIC_TOKEN=
